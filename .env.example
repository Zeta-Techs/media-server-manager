# Runtime data directory.  The directory must be local and writable by UID 10001 in Docker.
MSM_DATA_DIR=./data

MSM_WEB_HOST=0.0.0.0
MSM_WEB_PORT=8088
MSM_WEB_THREADS=8
MSM_TIMEZONE=Asia/Shanghai
MSM_WORKER_CONCURRENCY=2
MSM_ITEM_WORKERS=4
MSM_JOB_RETENTION_DAYS=90
MSM_WEBHOOK_RETENTION_DAYS=30
MSM_COOKIE_SECURE=0

# Optional externally managed session secret.  If omitted, it is generated in the database.
# MSM_SECRET_KEY=change-this-to-a-long-random-value

# Required for encrypting tokens and other secrets stored in the database.
MSM_LOCAL_ENCRYPTION_KEY=development-only-change-me

# Legacy aliases accepted during migration; prefer MSM_DATA_DIR.
# MSM_CONFIG_DIR=./config
# MSM_CONFIG_PATH=./config
